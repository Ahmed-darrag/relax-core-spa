{% extends "layouts.master" %}
{% block content %}
  <div class="s-blocks-wrapper s-before-product-info !mt-0">{% hook 'product.single.before_product_info' %}</div>
  <div class="container container--product-details">
    <salla-breadcrumb></salla-breadcrumb>
    <article id="product-{{ product.id }}">
      <h1>{{ product.name }}</h1>
      <div>{{ product.description|raw }}</div>
      <salla-add-product-button product-id="{{ product.id }}" product-status="{{ product.status }}" product-type="{{ product.type }}"></salla-add-product-button>
    </article>
  </div>
  <div class="s-blocks-wrapper s-before-reviews">{% hook 'product.single.before_customer_reviews' %}</div>
  {% if store.settings.rating.show_on_product %}<salla-comments item-id="{{ product.id }}" type="product"></salla-comments>{% endif %}
  <div class="s-blocks-wrapper s-before-related">{% hook 'product.single.before_product_recommendations' %}</div>
  <div class="container"><salla-products-slider source="related" source-value="{{ product.id }}"></salla-products-slider></div>
  <div class="s-blocks-wrapper s-after-related">{% hook 'product.single.after_product_recommendations' %}</div>
{% endblock %}
